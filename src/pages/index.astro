---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, site } from '../data/site';
---
<BaseLayout title="Thoughtful property care" description="Aura Living provides thoughtful residential property management and resident support across Virginia." path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{site.serviceArea}</span>
        <h1 class="display">Property care with a more thoughtful standard.</h1>
        <p class="lede">Aura Living brings calm coordination, clear communication, and a closer eye to the everyday work of caring for a home.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Start a conversation <span aria-hidden="true"> ↗</span></a>
          <a class="button button-secondary" href="/services/">Explore services</a>
        </div>
      </div>
      <div class="hero-art">
        <img src="/visuals/hero-home.svg" alt="Illustration of a warm, well-cared-for Virginia home" width="760" height="620" />
        <div class="art-note">Considered care, from the first conversation onward.</div>
      </div>
    </div>
  </section>
  <section class="trust-strip" aria-label="Aura Living principles">
    <div class="container trust-items">
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">✦</span><span>Clear communication</span></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">⌂</span><span>Virginia focused</span></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">◌</span><span>Resident minded</span></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">↗</span><span>Details coordinated</span></div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">The everyday, handled well</span>
        <h2>Quietly capable property support.</h2>
        <p>From a maintenance request to a renewal conversation, we help keep the moving pieces understandable and on track.</p>
      </div>
      <div class="card-grid">
        {services.slice(0, 3).map((service) => (
          <article class="service-card">
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href="/services/">See all services <span aria-hidden="true"> ↗</span></a>
    </div>
  </section>
  <section class="section split-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Two sides of a well-kept home</span>
        <h2>A better experience for everyone involved.</h2>
      </div>
      <div class="split-grid">
        <article class="split-card">
          <h3>For property owners</h3>
          <p>Stay informed without chasing details. We coordinate the daily work and share the context you need to make decisions with confidence.</p>
          <a class="text-link" href="/property-owners/">For property owners <span aria-hidden="true"> ↗</span></a>
        </article>
        <article class="split-card">
          <h3>For residents</h3>
          <p>Get a clear point of contact for questions, maintenance, inspections, and the details that make a home feel looked after.</p>
          <a class="text-link" href="/residents/">For residents <span aria-hidden="true"> ↗</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">A simple rhythm</span>
        <h2>Good care starts with a clear process.</h2>
      </div>
      <div class="process-grid">
        <div class="process-step"><h3>Listen first</h3><p>We learn what matters to your property, your residents, and your next decision.</p></div>
        <div class="process-step"><h3>Coordinate the details</h3><p>We keep requests, updates, and practical next steps moving in one clear direction.</p></div>
        <div class="process-step"><h3>Keep you in the loop</h3><p>You receive useful context rather than a stream of noise, so nothing important feels hidden.</p></div>
      </div>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      <div class="notice">
        <div><h3>Resident communication, when it is useful.</h3><p>SMS may be used for low-volume, one-to-one updates about property support. Final SMS activation depends on provider approval and carrier registration. Availability and delivery are not guaranteed.</p></div>
        <a class="text-link" href="/sms-terms/">Read SMS Terms <span aria-hidden="true"> ↗</span></a>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
