---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout title="For residents" description="Aura Living provides a clear point of contact for Virginia residents needing property and rental support." path="/residents/">
  <PageHero eyebrow="For residents" title="A home should feel supported." intro="From a maintenance question to a renewal conversation, we aim to make the next step clear and the communication respectful." />
  <section class="section">
    <div class="container content-grid">
      <div class="content-copy">
        <span class="eyebrow">Resident support</span>
        <h2>Help with the everyday details.</h2>
        <p>Good resident support is responsive, organized, and human. Aura Living helps keep requests and updates moving while respecting the people who call a property home.</p>
        <div class="feature-list">
          <div class="feature"><span class="feature-mark" aria-hidden="true">01</span><div><h3>Maintenance coordination</h3><p>Share a request and receive clear updates as the details are coordinated.</p></div></div>
          <div class="feature"><span class="feature-mark" aria-hidden="true">02</span><div><h3>Payment and rental communication</h3><p>Get timely information about rental payments, notices, and related questions.</p></div></div>
          <div class="feature"><span class="feature-mark" aria-hidden="true">03</span><div><h3>Inspections and renewals</h3><p>Know what to expect when an inspection or lease renewal conversation is approaching.</p></div></div>
        </div>
      </div>
      <aside class="side-card"><h2>Need to get in touch?</h2><p>Use the contact page for this demo website. In a live experience, your designated property contact details would be listed here.</p><a class="button" href="/contact/">Contact Aura Living</a></aside>
    </div>
  </section>
  <section class="section split-section"><div class="container split-grid"><div class="split-card"><span class="eyebrow">Communication that helps</span><h3>Useful updates, at the right moments.</h3><p>SMS may be used for low-volume, one-to-one resident or client messages when consent has been provided. Final activation depends on provider approval and carrier registration.</p><a class="text-link" href="/sms-terms/">View SMS Terms <span aria-hidden="true"> ↗</span></a></div><div class="image-panel"><img src="/visuals/detail-home.svg" alt="Abstract illustration of a welcoming home" width="720" height="520" /></div></div></section>
  <CtaBand title="A clearer line to the next step." text="If you are exploring support for a Virginia property, send a note and tell us what you need." />
</BaseLayout>
